# Postgres
POSTGRES_DB=waysklad
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis (только прод, см. docker-compose.prod.yml — requirepass)
REDIS_PASSWORD=change-me-long-random-string

# Backend
# ВАЖНО: в проде DEBUG обязательно 0/не задано — при DEBUG=1 открываются
# /docs, /redoc, /openapi.json без авторизации (вся карта API анонимно).
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/waysklad
SECRET_KEY=change-me-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=43200
DEBUG=1
# Публичный адрес backend (например https://waysklad.ru) — нужен только
# Telegram-боту витрины, чтобы отправлять абсолютный URL фото товара
# (Product.photo хранится относительным путём). Пусто (дефолт) — бот
# показывает карточку товара без фото, не падает.
PUBLIC_BASE_URL=
# RATE_LIMIT_STORAGE_URI, NOTIFICATIONS_REDIS_URL, CACHE_REDIS_URL задаются
# напрямую в environment: сервисов backend/scheduler/storefront_bot в
# docker-compose.prod.yml (все три — один и тот же Redis, разные логические
# БД) — здесь не нужны, REDIS_PASSWORD выше на них достаточно.

# Telegram
TELEGRAM_BOT_TOKEN=
# username бота витрины без "@" — нужен, чтобы собрать deep-link для входа
# покупателя (POST /api/auth/customer/login-link). Пусто (дефолт) — вход
# через Telegram недоступен (400 при попытке).
TELEGRAM_BOT_USERNAME=
# chat_id разработчика/оператора — сюда бот шлёт алерт при непредвиденной
# серверной ошибке (500 на продаже/долге/синке). Не chat_id владельца магазина.
ADMIN_ALERT_CHAT_ID=

# Генерация описания товара через ИИ (POST /api/products/{id}/description/generate).
# Пусто (дефолт) — эндпоинт отключён (400 при вызове).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Приватная админ-панель (статус сервера, список магазинов, лог ошибок) —
# POST /api/admin/login {login, password} -> JWT (Authorization: Bearer).
# Не связано с обычными пользователями (User/Role внутри магазина). Пусто
# (дефолт) — admin-роутер отключён (всегда 401 на /login).
# Хеш пароля сгенерировать:
#   python -c "from app.infrastructure.security import hash_password; print(hash_password('...'))"
ADMIN_LOGIN=
ADMIN_PASSWORD_HASH=
